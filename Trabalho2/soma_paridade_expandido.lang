I numeroBase = 13
I listaNumeros = [2, 7, 10, 5, 8]

FN somarVerificarParidade(I numeroLista, I numeroBase)
	I soma = numeroLista + numeroBase

	IF soma % 2 == 0
		R T
	EL
		R F

PT 'Número base fixo: $numeroBase\n'

FR index IN listaNumeros
	I soma = index + numeroBase

	IF somarVerificarParidade(index, numeroBase) & (soma > 15)
		PT 'Soma $index + $numeroBase = $soma (PAR e maior que 15)'
	EF somarVerificarParidade(index, numeroBase) | (soma == 13)
		PT 'Soma $index + $numeroBase = $soma (ÍMPAR ou igual a 13)'
	EL
		PT 'Soma $index + $numeroBase = $soma (Outro caso)'
